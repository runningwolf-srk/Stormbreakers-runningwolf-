import { ALL_RELICS } from "@/data/armory"
import { CANON } from "@/data/constants"
import { notFound } from "next/navigation"

export default function WordPage({ params }: { params:{ slug:string } }){
  const relic = ALL_RELICS.find(r=>r.slug===params.slug)
  if(!relic) return notFound()
  return (
    <div className="max-w-3xl mx-auto px-6 py-10">
      <div className="text-[10px] font-mono text-[#D4AF37]/50 tracking-widest">{CANON.TAGLINE}</div>
      <h1 className="text-4xl font-black mt-4 tracking-tighter">{relic.title} — WORD</h1>
      <div className="mt-3 text-sm text-white/60">{relic.purpose}</div>

      <div className="mt-8 space-y-4">
        <div className="border border-[#D4AF37]/20 rounded-2xl p-6 bg-[#D4AF37]/5"><div className="text-[10px] font-black tracking-widest text-[#D4AF37]">SCRIPTURE</div><div className="mt-2 font-bold">{relic.verse} — {relic.short}</div></div>
        <div className="border border-white/10 rounded-2xl p-6 bg-zinc-900/30"><div className="text-[10px] font-black tracking-widest">REFLECTION</div><div className="text-sm text-white/60 mt-2">God does not forge warriors alone. {relic.purpose}</div></div>
        <div className="border border-white/10 rounded-2xl p-6 bg-zinc-900/30"><div className="text-[10px] font-black tracking-widest">PRAYER</div><div className="text-sm text-white/60 mt-2 italic">Lord, forge {relic.title.toLowerCase()} in me. I serve One King.</div></div>
        <div className="border border-white/10 rounded-2xl p-6 bg-zinc-900/30"><div className="text-[10px] font-black tracking-widest">DAILY QUESTION</div><div className="text-sm text-white/60 mt-2">How do I live {relic.title} today?</div></div>
      </div>
    </div>
  )
}
